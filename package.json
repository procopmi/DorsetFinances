{
  "name": "dorset-finances",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only household finance app: checkbook registers, budgets, reports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:demo": "node src/server.js --demo",
    "setup": "node --env-file-if-exists=.env scripts/setup-real.js --setup",
    "seed": "node scripts/seed-sample.js --demo",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "backup:demo": "node scripts/backup.js --demo",
    "test": "node --test"
  }
}
